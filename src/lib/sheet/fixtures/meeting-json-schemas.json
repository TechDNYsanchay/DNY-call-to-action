{
  "sheet": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "headline": {
        "type": "string",
        "minLength": 10,
        "maxLength": 160,
        "description": "One sentence, at most 140 characters, stating the outcome of the meeting"
      },
      "executive_summary": {
        "minItems": 3,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "description": "Exactly 3 bullets, most important first, each self-contained"
      },
      "meeting_purpose": {
        "type": "string",
        "enum": [
          "review",
          "onboarding",
          "operations",
          "escalation",
          "training",
          "planning",
          "renewal_or_commercial",
          "other"
        ]
      },
      "language_profile": {
        "type": "object",
        "properties": {
          "primary": {
            "type": "string",
            "enum": [
              "english",
              "hindi",
              "hinglish",
              "other"
            ]
          },
          "mixed": {
            "type": "boolean"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "primary",
          "mixed",
          "notes"
        ],
        "additionalProperties": false
      },
      "action_items": {
        "maxItems": 40,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "A1, A2, ..."
            },
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 140,
              "description": "Verb-first, at most 12 words, e.g. 'Share revised duty roster with owner'"
            },
            "details": {
              "type": "string",
              "maxLength": 1000,
              "description": "What exactly, why, any conditions; one to three sentences; empty string if the title says it all"
            },
            "owed_by": {
              "type": "string",
              "enum": [
                "dny",
                "client",
                "both",
                "unclear"
              ],
              "description": "Who owes this task: dny or client (both when it is genuinely joint)"
            },
            "owner": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "Canonical participant name only when the transcript supports it; null otherwise",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "side": {
                  "type": "string",
                  "enum": [
                    "dny",
                    "client",
                    "unknown"
                  ]
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "explicitly_assigned",
                    "volunteered",
                    "implied_by_role",
                    "not_stated"
                  ]
                }
              },
              "required": [
                "name",
                "side",
                "basis"
              ],
              "additionalProperties": false
            },
            "due": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "explicit_date",
                    "relative_phrase",
                    "asap",
                    "none_stated"
                  ]
                },
                "date": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "YYYY-MM-DD, only when explicit or unambiguously derivable from the meeting date"
                },
                "raw_phrase": {
                  "description": "The words used, e.g. 'by Friday', 'agle hafte tak'",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "basis": {
                  "description": "How the date was derived, e.g. 'meeting on Tue 4 Nov; next Friday = 7 Nov'",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "date",
                "raw_phrase",
                "basis"
              ],
              "additionalProperties": false
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "linked_decision_id": {
              "description": "Decision id this task implements, if any",
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "description": "The marker of the transcript line relied on, copied exactly, e.g. 12:34 or 1:02:10"
                  },
                  "speaker": {
                    "type": "string",
                    "description": "Speaker label exactly as it appears on that line, without the (DNY)/(Client) tag"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "Verbatim words from that line, original language and script, at most 30 words"
                  },
                  "quote_english": {
                    "description": "Plain-English rendering when the quote is not already English; null otherwise",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "timestamp",
                  "speaker",
                  "quote",
                  "quote_english"
                ],
                "additionalProperties": false
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "title",
            "details",
            "owed_by",
            "owner",
            "due",
            "priority",
            "linked_decision_id",
            "evidence",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "decisions": {
        "maxItems": 30,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "D1, D2, ..."
            },
            "statement": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "The decision as a plain statement of fact"
            },
            "decided_by": {
              "type": "string",
              "enum": [
                "dny",
                "client",
                "joint",
                "unclear"
              ]
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "description": "The marker of the transcript line relied on, copied exactly, e.g. 12:34 or 1:02:10"
                  },
                  "speaker": {
                    "type": "string",
                    "description": "Speaker label exactly as it appears on that line, without the (DNY)/(Client) tag"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "Verbatim words from that line, original language and script, at most 30 words"
                  },
                  "quote_english": {
                    "description": "Plain-English rendering when the quote is not already English; null otherwise",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "timestamp",
                  "speaker",
                  "quote",
                  "quote_english"
                ],
                "additionalProperties": false
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "statement",
            "decided_by",
            "evidence",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "key_facts": {
        "maxItems": 40,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "F1, F2, ..."
            },
            "fact": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300,
              "description": "One sentence, value as said"
            },
            "category": {
              "type": "string",
              "enum": [
                "money",
                "date",
                "quantity",
                "metric",
                "contract",
                "staffing",
                "property",
                "process",
                "other"
              ]
            },
            "normalized_value": {
              "description": "Machine-friendly form, e.g. 'INR 250000', '2026-11-15', '72%'",
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "description": "The marker of the transcript line relied on, copied exactly, e.g. 12:34 or 1:02:10"
                  },
                  "speaker": {
                    "type": "string",
                    "description": "Speaker label exactly as it appears on that line, without the (DNY)/(Client) tag"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "Verbatim words from that line, original language and script, at most 30 words"
                  },
                  "quote_english": {
                    "description": "Plain-English rendering when the quote is not already English; null otherwise",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "timestamp",
                  "speaker",
                  "quote",
                  "quote_english"
                ],
                "additionalProperties": false
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "fact",
            "category",
            "normalized_value",
            "evidence",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "risks": {
        "maxItems": 20,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "R1, R2, ..."
            },
            "description": {
              "type": "string",
              "minLength": 3,
              "maxLength": 400
            },
            "severity": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "affects": {
              "type": "string",
              "enum": [
                "dny",
                "client",
                "both",
                "unclear"
              ]
            },
            "mitigation_discussed": {
              "description": "What the participants said they would do about it, if anything",
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "description": "The marker of the transcript line relied on, copied exactly, e.g. 12:34 or 1:02:10"
                  },
                  "speaker": {
                    "type": "string",
                    "description": "Speaker label exactly as it appears on that line, without the (DNY)/(Client) tag"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "Verbatim words from that line, original language and script, at most 30 words"
                  },
                  "quote_english": {
                    "description": "Plain-English rendering when the quote is not already English; null otherwise",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "timestamp",
                  "speaker",
                  "quote",
                  "quote_english"
                ],
                "additionalProperties": false
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "description",
            "severity",
            "affects",
            "mitigation_discussed",
            "evidence",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "open_questions": {
        "maxItems": 20,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Q1, Q2, ..."
            },
            "question": {
              "type": "string",
              "minLength": 3,
              "maxLength": 300
            },
            "raised_by": {
              "type": "string",
              "enum": [
                "dny",
                "client",
                "unclear"
              ]
            },
            "needs_answer_from": {
              "type": "string",
              "enum": [
                "dny",
                "client",
                "unclear"
              ]
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "string",
                    "description": "The marker of the transcript line relied on, copied exactly, e.g. 12:34 or 1:02:10"
                  },
                  "speaker": {
                    "type": "string",
                    "description": "Speaker label exactly as it appears on that line, without the (DNY)/(Client) tag"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400,
                    "description": "Verbatim words from that line, original language and script, at most 30 words"
                  },
                  "quote_english": {
                    "description": "Plain-English rendering when the quote is not already English; null otherwise",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "timestamp",
                  "speaker",
                  "quote",
                  "quote_english"
                ],
                "additionalProperties": false
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "id",
            "question",
            "raised_by",
            "needs_answer_from",
            "evidence",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "next_meeting": {
        "type": "object",
        "properties": {
          "mentioned": {
            "type": "boolean"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "raw_phrase": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": {
                  "type": "string",
                  "description": "The marker of the transcript line relied on, copied exactly, e.g. 12:34 or 1:02:10"
                },
                "speaker": {
                  "type": "string",
                  "description": "Speaker label exactly as it appears on that line, without the (DNY)/(Client) tag"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "description": "Verbatim words from that line, original language and script, at most 30 words"
                },
                "quote_english": {
                  "description": "Plain-English rendering when the quote is not already English; null otherwise",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "timestamp",
                "speaker",
                "quote",
                "quote_english"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "mentioned",
          "date",
          "raw_phrase",
          "purpose",
          "evidence",
          "confidence"
        ],
        "additionalProperties": false
      },
      "client_sentiment": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "enum": [
              "very_positive",
              "positive",
              "neutral",
              "concerned",
              "frustrated",
              "mixed"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 3,
            "maxLength": 300,
            "description": "One sentence on how the client side sounded about DNY and the engagement"
          },
          "drivers": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Short phrases, e.g. 'praised the new chef', 'unhappy about delayed MIS'"
          },
          "evidence": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": {
                  "type": "string",
                  "description": "The marker of the transcript line relied on, copied exactly, e.g. 12:34 or 1:02:10"
                },
                "speaker": {
                  "type": "string",
                  "description": "Speaker label exactly as it appears on that line, without the (DNY)/(Client) tag"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "description": "Verbatim words from that line, original language and script, at most 30 words"
                },
                "quote_english": {
                  "description": "Plain-English rendering when the quote is not already English; null otherwise",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "timestamp",
                "speaker",
                "quote",
                "quote_english"
              ],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "label",
          "summary",
          "drivers",
          "evidence",
          "confidence"
        ],
        "additionalProperties": false
      },
      "participants": {
        "maxItems": 30,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "speaker_label": {
              "type": "string",
              "description": "Exactly as it appears in the transcript"
            },
            "name": {
              "description": "Canonical name from the participants list, if matched",
              "type": [
                "string",
                "null"
              ]
            },
            "side": {
              "type": "string",
              "enum": [
                "dny",
                "client",
                "third_party",
                "unknown"
              ]
            },
            "role_guess": {
              "description": "e.g. 'owner', 'GM', 'DNY account manager', only if evident",
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "speaker_label",
            "name",
            "side",
            "role_guess",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "quality": {
        "type": "object",
        "properties": {
          "transcript_quality": {
            "type": "string",
            "enum": [
              "good",
              "fair",
              "poor"
            ]
          },
          "speaker_labels_reliable": {
            "type": "boolean"
          },
          "issues": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "unresolved_references": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "required": [
          "transcript_quality",
          "speaker_labels_reliable",
          "issues",
          "unresolved_references"
        ],
        "additionalProperties": false
      },
      "overall_confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "required": [
      "headline",
      "executive_summary",
      "meeting_purpose",
      "language_profile",
      "action_items",
      "decisions",
      "key_facts",
      "risks",
      "open_questions",
      "next_meeting",
      "client_sentiment",
      "participants",
      "quality",
      "overall_confidence"
    ],
    "additionalProperties": false
  },
  "classification": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "client",
          "sales",
          "internal",
          "other"
        ],
        "description": "client = DNY already serves this party (review, onboarding, operations, escalation). sales = DNY is trying to win or quote a new engagement. internal = only DNY staff. other = vendor, recruitment, personal, or no usable content."
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1,
        "description": "0.9+ only when the transcript explicitly shows an existing engagement (client) or a first-contact pitch (sales)"
      },
      "reason": {
        "type": "string",
        "minLength": 3,
        "maxLength": 400,
        "description": "One or two plain-English sentences a non-technical reviewer can read on the card"
      },
      "evidence": {
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "timestamp": {
              "type": "string",
              "description": "The marker of the transcript line relied on, copied exactly, e.g. 12:34 or 1:02:10"
            },
            "speaker": {
              "type": "string",
              "description": "Speaker label exactly as it appears on that line, without the (DNY)/(Client) tag"
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "description": "Verbatim words from that line, original language and script, at most 30 words"
            },
            "quote_english": {
              "description": "Plain-English rendering when the quote is not already English; null otherwise",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "timestamp",
            "speaker",
            "quote",
            "quote_english"
          ],
          "additionalProperties": false
        }
      },
      "client_name_guess": {
        "description": "Name of the hotel/restaurant/company on the other side if it is said in the meeting; null if not said",
        "type": [
          "string",
          "null"
        ]
      },
      "language": {
        "type": "string",
        "enum": [
          "english",
          "hindi",
          "hinglish",
          "other"
        ]
      }
    },
    "required": [
      "type",
      "confidence",
      "reason",
      "evidence",
      "client_name_guess",
      "language"
    ],
    "additionalProperties": false
  }
}
